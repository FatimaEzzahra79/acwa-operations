# =============================================================
# ACWA Operations - Environment template
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored: real credentials never reach GitHub.
# =============================================================

# --- Server ---
PORT=3000

# --- MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=noor_inventory
DB_PORT=3306

# --- Security ---
# Generate a strong secret, e.g.:  openssl rand -hex 48
JWT_SECRET=

# Password assigned to the admin account created on first boot.
# Leave empty to auto-generate a random one (printed in the server console).
ADMIN_SEED_PASSWORD=
